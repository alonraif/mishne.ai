# Copy to .env for local development. Never commit a real key.

ENVIRONMENT=local

# The OWNER connection. Alembic uses this, and nothing else should:
# `mishne` is the superuser docker-compose creates, and a superuser bypasses
# row-level security entirely.
DATABASE_URL=postgresql://mishne:mishne@localhost:5432/mishne

# The APPLICATION connection — a member of the `mishne_app` role, created by
# infra/local-app-user.sql. Not a superuser, no BYPASSRLS, so the policies
# actually apply. See apps/api/migrations/README.md.
APP_DATABASE_URL=postgresql://mishne_local:mishne_local@localhost:5432/mishne

# Serve fixtures instead of querying Postgres. Refused outside ENVIRONMENT=local.
USE_MOCKS=true

# Which org a request belongs to until B4 provides a real identity. Local only.
DEV_ORG_ID=org_7fa2

# Identity (B4). `local` is email and password in our own database — what a
# developer's machine uses. `workos` is the hosted provider that carries SAML
# SSO and SCIM, and it needs the two keys below to boot.
AUTH_PROVIDER=local
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Optional: pin sign-in to one customer's connection or organisation.
WORKOS_CONNECTION_ID=
WORKOS_ORGANIZATION_ID=

# Where the web app is served from. The session cookie and the CORS policy are
# both scoped to it; outside local development it must be https.
APP_ORIGIN=http://localhost:3000

AWS_REGION=eu-west-1
S3_BUCKET_RAW=mishne-dev-raw
S3_BUCKET_DERIVED=mishne-dev-derived
S3_BUCKET_ARTIFACTS=mishne-dev-artifacts

# Transcription. `auto` routes by language across the managed engines in
# asr/engines.json — xAI for the languages it publishes, Gemini for Hebrew and
# everything else (ADR-0018). `faster-whisper` self-hosts; `mock` and `replay`
# are for tests. The engines read their keys from the vendor variables below,
# not from ASR_API_KEY, because a vendor has one key and not one per subsystem.
ASR_PROVIDER=auto
ASR_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Transcription and language models both. XAI_API_KEY buys $0.10/source-hour
# transcription; GEMINI_API_KEY is the one Hebrew needs.
XAI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

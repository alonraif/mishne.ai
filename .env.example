# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true

# API
DATABASE_URL=postgresql://mishne:mishne@localhost:5432/mishne
S3_BUCKET_RAW=mishne-dev-raw
S3_BUCKET_DERIVED=mishne-dev-derived
S3_BUCKET_ARTIFACTS=mishne-dev-artifacts
AWS_REGION=eu-west-1

# Vendors — never commit real keys
ASR_PROVIDER=mock
ASR_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only for an identity-linked Anthropic key (the kind an org policy usually
# issues). Such a key is not tied to a workspace, so the API refuses with a 400
# naming this header. A workspace-scoped key does not need it.
ANTHROPIC_WORKSPACE_ID=

# Back-office (migration 0009). A separate process, a separate credential, and
# the one connection in the system that bypasses row-level security. Locally
# the compose superuser is that connection; in a deployment, make a role with
# BYPASSRLS and point this at it.
ADMIN_DATABASE_URL=postgresql://mishne:mishne@localhost:5432/mishne
ADMIN_ORIGIN=http://localhost:3001
ADMIN_SESSION_HOURS=8
# The back-office binds to loopback and refuses anything else unless this is
# on. Turn it on only when something in front of it is doing access control.
ADMIN_ALLOW_PUBLIC_BIND=false

# apps/admin
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:8001

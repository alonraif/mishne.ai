# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=true

# API
DATABASE_URL=postgresql://mishne:mishne@localhost:5432/mishne
S3_BUCKET_RAW=mishne-dev-raw
S3_BUCKET_DERIVED=mishne-dev-derived
S3_BUCKET_ARTIFACTS=mishne-dev-artifacts
AWS_REGION=eu-west-1

# Vendors — never commit real keys
ASR_PROVIDER=mock
ASR_API_KEY=
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Only for an identity-linked Anthropic key (the kind an org policy usually
# issues). Such a key is not tied to a workspace, so the API refuses with a 400
# naming this header. A workspace-scoped key does not need it.
ANTHROPIC_WORKSPACE_ID=
